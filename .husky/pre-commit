#!/usr/bin/env sh

# #region agent log
DEBUG_LOG="/Users/frissonlabs/Projects/ungate/.cursor/debug-b77aae.log"
_log() {
  printf '%s\n' "{\"sessionId\":\"b77aae\",\"runId\":\"post-fix\",\"timestamp\":$(date +%s000),\"location\":\"pre-commit\",\"hypothesisId\":\"$1\",\"message\":\"$2\",\"data\":$3}" >> "$DEBUG_LOG"
}
_log "A" "hook PATH at start" "{\"PATH\":\"$(printf '%s' "$PATH" | sed 's/\\/\\\\/g; s/"/\\"/g')\",\"HOME\":\"$HOME\"}"
_log "B" "pnpm resolution before PATH fix" "{\"command_v_pnpm\":\"$(command -v pnpm || echo MISSING)\",\"homebrew_pnpm\":\"$([ -x /opt/homebrew/bin/pnpm ] && echo exists || echo missing)\",\"node\":\"$(command -v node || echo MISSING)\"}"
# #endregion

# Cursor/VS Code git hooks use a minimal PATH that omits Homebrew (and often nvm),
# so `pnpm` / `node` are not found. Prepend common install locations.
for dir in /opt/homebrew/bin /usr/local/bin "$HOME/Library/pnpm"; do
	[ -d "$dir" ] || continue
	case ":$PATH:" in
		*":$dir:"*) ;;
		*) PATH="$dir:$PATH" ;;
	esac
done
export PATH

# #region agent log
_log "E" "pnpm resolution after PATH fix" "{\"PATH\":\"$(printf '%s' "$PATH" | sed 's/\\/\\\\/g; s/"/\\"/g')\",\"command_v_pnpm\":\"$(command -v pnpm || echo MISSING)\",\"node\":\"$(command -v node || echo MISSING)\",\"pnpm_version\":\"$(pnpm -v 2>/dev/null || echo FAILED)\"}"
# #endregion

pnpm exec lint-staged
pnpm test
